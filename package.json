{
  "name": "utsushi-casting",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual (EN/JA) studio website for a fictional casting agency. Next.js App Router, Sanity with field-level localization, Vercel.",
  "license": "MIT",
  "author": "Milan Georgijevic",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budget": "node scripts/check-js-budget.mjs",
    "seed": "tsx scripts/seed-sanity.ts",
    "media": "python3 scripts/media/generate.py",
    "schema:enquiry": "tsx scripts/generate-payload-schema.ts"
  },
  "dependencies": {
    "@portabletext/react": "8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "7.27.0",
    "@sanity/vision": "6.17.0",
    "@upstash/redis": "1.39.0",
    "gsap": "3.15.0",
    "next": "16.3.8",
    "next-sanity": "13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.17.0",
    "styled-components": "6.5.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
