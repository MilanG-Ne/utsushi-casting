# Canonical origin for canonical/hreflang/sitemap URLs. On Vercel this falls back to the
# production domain automatically (VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity ----------------------------------------------------------------------------
# Leave the project ID empty to build from the bundled seed content (content/seed).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token, only needed by `pnpm seed`. Never expose it to the browser.
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=
# Force the bundled content even when a project ID is set: fixture | sanity
# CONTENT_SOURCE=fixture

# --- Enquiries (all optional; see docs/enquiry-payload.md) ----------------------------
# CRM endpoint. Default: this site's mock CRM at /api/mock-crm/enquiries
CRM_ENDPOINT=
CRM_SIGNING_SECRET=change-me
CRM_API_KEY=
# Durable outbox (Upstash Redis REST). The Vercel integration sets KV_REST_API_URL/TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Email fallback through Resend
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=
ENQUIRY_EMAIL_FROM="Utsushi Casting website <onboarding@resend.dev>"
# Protects /api/enquiries/retry (Vercel Cron sends it automatically)
CRON_SECRET=change-me-too
# Simulate CRM outages on the mock: MOCK_CRM_MODE=down or MOCK_CRM_FAILURE_RATE=0.3
MOCK_CRM_MODE=up

# --- Analytics --------------------------------------------------------------------------
# Your site's Plausible script URL (Site settings → Site installation), e.g.
# https://plausible.io/js/pa-XXXXXXXX.js. Leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
